{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "gitleaks",
     "semanticVersion": "v8.0.0",
     "informationUri": "https://github.com/gitleaks/gitleaks",
     "rules": [
      {
       "id": "aws-access-token"
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "aws-access-token",
     "message": {
      "text": "redacted"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "sample.txt"
        },
        "region": {
         "startLine": 1
        }
       }
      }
     ]
    }
   ]
  }
 ]
}